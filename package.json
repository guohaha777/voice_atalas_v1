{
  "name": "wanwu-shengpu-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "万物声谱正式 H5 前端，按页面逐步验收",
  "engines": { "node": ">=22.22.0" },
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm run dev --workspace=@wanwu-v2/web",
    "typecheck": "npm run typecheck --workspace=@wanwu-v2/web",
    "test": "node --experimental-strip-types --test apps/web/tests/*.test.ts",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "build": "npm run typecheck && npm run check:assets && npm run build --workspace=@wanwu-v2/web",
    "preview": "npm run preview --workspace=@wanwu-v2/web"
  },
  "devDependencies": {"typescript":"6.0.3","@types/node":"24.19.2","sharp":"0.35.5"}
}
